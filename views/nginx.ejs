<section class="mb-8" aria-labelledby="nginx-heading">
  <h1 id="nginx-heading" class="font-sans text-headline-lg cr-gradient-text font-bold mb-6">Nginx Config Generator</h1>
  <p class="text-cr-muted mb-4">Genera e applica la configurazione Nginx per un nuovo dominio. Il file viene creato in <code class="text-cr-accent">/etc/nginx/sites-available/</code>, viene creato il symlink in sites-enabled e Nginx viene ricaricato.</p>

  <div class="mb-6 flex flex-wrap items-center gap-2 max-w-xl" aria-live="polite">
    <span class="text-sm text-cr-muted">Sudo Nginx:</span>
    <span id="nginxSudoBadge" class="px-2 py-0.5 rounded text-xs font-medium bg-cr-surface2 text-cr-muted">Verifica…</span>
  </div>

  <div class="cr-glass p-6 max-w-xl">
    <form id="nginxForm" class="space-y-4">
      <div>
        <label for="nginxDomain" class="block text-sm text-cr-muted mb-1">Dominio</label>
        <input type="text" id="nginxDomain" name="domain" required
          placeholder="api.miosito.com"
          class="w-full px-4 py-2 rounded-lg bg-cr-surface2 border border-cr-inputBorder text-cr-text font-mono" />
      </div>
      <div>
        <label for="nginxPort" class="block text-sm text-cr-muted mb-1">Porta locale (app Node.js)</label>
        <input type="number" id="nginxPort" name="port" value="3000" min="1" max="65535" required
          class="w-full px-4 py-2 rounded-lg bg-cr-surface2 border border-cr-inputBorder text-cr-text" />
      </div>
      <div>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="nginxSsl" name="ssl" value="1"
            class="rounded border-cr-inputBorder bg-cr-surface2 text-cr-accent focus:ring-cr-accent" />
          <span class="text-cr-text">Configura SSL con Certbot (richiede che il dominio punti già al server)</span>
        </label>
      </div>
      <button type="submit" id="btnNginxGenerate" class="px-4 py-2 rounded-lg bg-cr-accent hover:opacity-90 text-white dark:text-slate-900 font-medium focus:outline-none focus:ring-2 focus:ring-cr-accent focus:ring-offset-2 focus:ring-offset-cr-surface">
        Genera e applica
      </button>
      <button type="button" id="btnNginxPreview" class="px-4 py-2 rounded-lg bg-cr-surface2 hover:bg-cr-navHover ml-2">
        Preview config
      </button>
    </form>
    <div id="nginxOutput" class="mt-4 p-4 bg-cr-code rounded-lg font-mono text-sm text-cr-text hidden"></div>
    <div id="nginxRollbackWrap" class="mt-3 hidden">
      <button type="button" id="btnNginxRollback" class="px-4 py-2 rounded-lg bg-cr-warning hover:opacity-90 text-white dark:text-slate-900 font-medium">Rollback ultima config</button>
    </div>
  </div>

  <details id="nginxSudoSetup" class="mt-6 max-w-xl group" open>
    <summary class="cursor-pointer list-none flex items-center justify-between gap-2 p-4 bg-[var(--cr-warning-bg)] border border-cr-warning rounded-lg text-sm text-cr-warning font-medium">
      <span>Setup sudo (serve se Genera / Reload falliscono)</span>
      <span class="text-xs font-normal opacity-80 group-open:hidden">Mostra</span>
      <span class="text-xs font-normal opacity-80 hidden group-open:inline">Nascondi</span>
    </summary>
    <div class="mt-2 p-4 bg-[var(--cr-warning-bg)] border border-cr-warning rounded-lg text-sm text-cr-warning">
      <p class="mb-2">Aggiungi le regole in <code class="text-cr-warning">/etc/sudoers.d/control-room-nginx</code> (e reload in <code class="text-cr-warning">/etc/sudoers.d/control-room</code>):</p>
      <pre class="mt-2 text-xs overflow-x-auto whitespace-pre-wrap">ubuntu ALL=(ALL) NOPASSWD: /usr/bin/cp /tmp/controlroom-nginx-*.conf /etc/nginx/sites-available/
ubuntu ALL=(ALL) NOPASSWD: /usr/bin/cp /etc/nginx/sites-available/* /tmp/controlroom-nginx-backup-*
ubuntu ALL=(ALL) NOPASSWD: /usr/bin/cp /tmp/controlroom-nginx-backup-* /etc/nginx/sites-available/
ubuntu ALL=(ALL) NOPASSWD: /usr/bin/ln -sf /etc/nginx/sites-available/* /etc/nginx/sites-enabled/
ubuntu ALL=(ALL) NOPASSWD: /usr/sbin/nginx -t
ubuntu ALL=(ALL) NOPASSWD: /bin/systemctl reload nginx
ubuntu ALL=(ALL) NOPASSWD: /usr/bin/certbot certonly --nginx -d *</pre>
      <p id="nginxSudoHints" class="mt-3 text-xs text-cr-muted hidden"></p>
    </div>
  </details>
</section>

<script>
  let lastRollbackHint = '';

  async function loadNginxSudoStatus() {
    const badge = document.getElementById('nginxSudoBadge');
    const setup = document.getElementById('nginxSudoSetup');
    const hintsEl = document.getElementById('nginxSudoHints');
    try {
      const res = await fetch('/api/nginx-sudo-status');
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'status HTTP ' + res.status);
      const ok = data.ok === true;
      badge.textContent = ok ? 'configurato' : 'da configurare';
      badge.className = ok
        ? 'px-2 py-0.5 rounded text-xs font-medium bg-[var(--cr-success-bg)] text-cr-accent'
        : 'px-2 py-0.5 rounded text-xs font-medium bg-[var(--cr-warning-bg)] text-cr-warning';
      if (setup) {
        if (ok) setup.removeAttribute('open');
        else setup.setAttribute('open', '');
      }
      if (hintsEl) {
        const hints = Array.isArray(data.hints) ? data.hints.filter(Boolean) : [];
        if (hints.length && !ok) {
          hintsEl.textContent = hints.join(' ');
          hintsEl.classList.remove('hidden');
        } else {
          hintsEl.classList.add('hidden');
        }
      }
    } catch (err) {
      badge.textContent = 'verifica fallita';
      badge.className = 'px-2 py-0.5 rounded text-xs font-medium bg-[var(--cr-danger-bg)] text-cr-danger';
      if (setup) setup.setAttribute('open', '');
    }
  }

  loadNginxSudoStatus();

  document.getElementById('btnNginxPreview').addEventListener('click', async function() {
    const domain = document.getElementById('nginxDomain').value.trim();
    const port = parseInt(document.getElementById('nginxPort').value || '3000', 10);
    const output = document.getElementById('nginxOutput');
    output.classList.remove('hidden');
    output.textContent = 'Generazione preview...';
    try {
      const res = await fetch('/api/nginx-preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ domain, port })
      });
      const json = await res.json();
      if (!json.ok) throw new Error(json.error || 'Preview fallita');
      output.textContent = json.config;
      output.className = 'mt-4 p-4 bg-cr-code rounded-lg font-mono text-sm text-cr-text';
    } catch (err) {
      output.textContent = 'Errore preview: ' + err.message;
      output.className = 'mt-4 p-4 bg-cr-code rounded-lg font-mono text-sm text-cr-danger';
    }
  });

  document.getElementById('nginxForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const domain = document.getElementById('nginxDomain').value.trim();
    const port = parseInt(document.getElementById('nginxPort').value || '3000', 10);
    const ssl = document.getElementById('nginxSsl').checked;
    const output = document.getElementById('nginxOutput');
    output.classList.remove('hidden');
    output.textContent = 'Elaborazione in corso...';
    document.getElementById('btnNginxGenerate').disabled = true;
    try {
      const res = await fetch('/api/nginx-generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ domain, port, ssl })
      });
      const json = await res.json();
      output.textContent = (json.output || '') + (json.error ? '\n\nErrore: ' + json.error : '');
      output.className = 'mt-4 p-4 bg-cr-code rounded-lg font-mono text-sm ' + (json.ok ? 'text-cr-accent' : 'text-cr-danger');
      if (json.ok) {
        lastRollbackHint = json.rollbackHint || '';
        document.getElementById('nginxRollbackWrap').classList.toggle('hidden', !lastRollbackHint);
        window.dispatchEvent(new CustomEvent('toast', { detail: { message: 'Configurazione Nginx applicata', type: 'success' } }));
      }
      loadNginxSudoStatus();
    } catch (err) {
      output.textContent = 'Errore: ' + err.message;
      output.className = 'mt-4 p-4 bg-cr-code rounded-lg font-mono text-sm text-cr-danger';
    }
    document.getElementById('btnNginxGenerate').disabled = false;
  });

  document.getElementById('btnNginxRollback').addEventListener('click', async function() {
    const domain = document.getElementById('nginxDomain').value.trim();
    if (!lastRollbackHint || !domain) {
      window.dispatchEvent(new CustomEvent('toast', { detail: { message: 'Rollback non disponibile', type: 'error' } }));
      return;
    }
    try {
      const res = await fetch('/api/nginx-rollback', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ backupPath: lastRollbackHint, domain })
      });
      const json = await res.json();
      if (!json.ok) throw new Error(json.error || 'Rollback fallito');
      window.dispatchEvent(new CustomEvent('toast', { detail: { message: 'Rollback Nginx completato', type: 'success' } }));
    } catch (err) {
      window.dispatchEvent(new CustomEvent('toast', { detail: { message: 'Errore rollback: ' + err.message, type: 'error' } }));
    }
  });
</script>
